---
// PostsLayout.astro — 文章详情页布局（左侧边栏 + 正文 + 目录）
import BaseLayout from './BaseLayout.astro';
import GlobalSidebar from '../components/posts/GlobalSidebar.astro';
import TableOfContents from '../components/posts/TableOfContents.astro';
import Breadcrumb from '../components/posts/Breadcrumb.astro';
import '../assets/css/markdown.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface BreadcrumbItem {
  label: string;
  href?: string;
  icon?: string;
}

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  breadcrumbs: BreadcrumbItem[];
}

const { title, description, headings, breadcrumbs } = Astro.props;
const hasToc = headings && headings.length > 0;
---

<BaseLayout title={title} description={description}>
  <div class="posts-with-sidebar">
    <div class="posts-sidebar-wrap">
      <GlobalSidebar>
        <Breadcrumb items={breadcrumbs} slot="top" />
      </GlobalSidebar>
    </div>
    <div class="posts-content">
      <div class="post-layout">
        <div class="post-main">
          <div class="posts-breadcrumb">
            <Breadcrumb items={breadcrumbs} />
          </div>
          <article class="post-content glass glass-tall" data-pagefind-body>
            <div class="post-content-inner">
              <slot />
            </div>
          </article>
          <slot name="postnav" />
          <slot name="comments" />
        </div>
        {hasToc && (
          <aside class="post-sidebar">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 左侧边栏 + 内容列 */
  .posts-with-sidebar {
    width: 100%;
    max-width: 1200px;
    display: flex;
    align-items: flex-start;
    gap: 24px;
    min-width: 0;
  }

  .posts-sidebar-wrap {
    width: 260px;
    flex-shrink: 0;
  }

  .posts-content {
    flex: 1 1 auto;
    min-width: 0;
  }

  .post-layout {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .post-main {
    flex: 1;
    min-width: 0;
    padding-top: 38px;
  }

  .post-content {
    border-radius: var(--radius);
  }

  /* 面包屑：桌面端在侧边栏内，移动端在卡片上方显示 */
  .posts-breadcrumb {
    display: none;
    margin-bottom: 16px;
  }

  .post-content-inner {
    padding: 36px 40px;
  }

  .post-sidebar {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: 88px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  @media (max-width: 1000px) {
    .posts-sidebar-wrap {
      display: none;
    }

    .posts-breadcrumb {
      display: block;
    }

    .post-main {
      padding-top: 0;
    }
  }

  @media (max-width: 768px) {
    .post-layout {
      display: block;
    }

    .post-sidebar {
      display: none;
    }

    .post-content-inner {
      padding: 16px;
    }
  }
</style>
