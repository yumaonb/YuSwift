---
// PostsLayout.astro — 文章详情页布局（左侧边栏 + 正文 + 目录）
import BaseLayout from './BaseLayout.astro';
import GlobalSidebar from '../components/posts/GlobalSidebar.astro';
import TableOfContents from '../components/posts/TableOfContents.astro';
import Breadcrumb from '../components/posts/Breadcrumb.astro';
import type { BreadcrumbItem, CategoryTreeNode } from '../lib/category';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  headings: Heading[];
  breadcrumbs: BreadcrumbItem[];
  /** 侧栏分类树（来自 loadBlogData()） */
  categoryTree: CategoryTreeNode[];
  /** 侧栏标签计数（来自 loadBlogData()） */
  sidebarTags: { name: string; count: number }[];
}

const { title, description, headings, breadcrumbs, categoryTree, sidebarTags } = Astro.props;
const hasToc = headings && headings.length > 0;
---

<BaseLayout title={title} description={description}>
  <div class="posts-with-sidebar">
    <div class="posts-sidebar-wrap">
      <GlobalSidebar tree={categoryTree} tags={sidebarTags}>
        <Breadcrumb items={breadcrumbs} slot="top" />
      </GlobalSidebar>
    </div>
    <div class="posts-content">
      <div class="post-layout">
        <div class="post-main">
          <div class="posts-breadcrumb">
            <Breadcrumb items={breadcrumbs} />
          </div>
          <article class="post-content glass glass-tall" data-pagefind-body>
            <div class="post-content-inner">
              <slot />
            </div>
          </article>
          <slot name="postnav" />
          <slot name="comments" />
        </div>
        {hasToc && (
          <aside class="post-sidebar">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* 整行容器：与列表/分类页一致，限制最大宽度并居中（main.hero 的
     justify-content: center + width:100% 即可让该容器居中，不会贴左） */
  .posts-with-sidebar {
    max-width: 1200px;
  }

  .post-layout {
    display: flex;
    gap: 32px;
    align-items: flex-start;
  }

  .post-main {
    flex: 1;
    min-width: 0;
    padding-top: 38px;
  }

  .post-content {
    border-radius: var(--radius);
  }

  /* 面包屑：桌面端在侧边栏内，移动端在卡片上方显示 */
  .posts-breadcrumb {
    display: none;
    margin-bottom: 16px;
  }

  .posts-sidebar-wrap {
    /* 让侧栏拉伸到正文列高度：wrapper 对齐到行高（覆盖容器 align-items:flex-start），
       内部 display:flex 使 .global-sidebar 的 align-self:stretch 生效，
       .sidebar-filter 的 position:sticky 才有滚动行程（与列表页直接子元素一致） */
    align-self: stretch;
    display: flex;
  }

  .post-content-inner {
    padding: 36px 40px;
  }

  .post-sidebar {
    width: 240px;
    flex-shrink: 0;
    position: sticky;
    top: 88px;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  @media (max-width: 1000px) {
    .posts-sidebar-wrap {
      display: none;
    }

    .posts-breadcrumb {
      display: block;
    }

    .post-main {
      padding-top: 0;
    }
  }

  @media (max-width: 768px) {
    .post-layout {
      display: block;
    }

    .post-sidebar {
      display: none;
    }

    .post-content-inner {
      padding: 16px;
    }
  }
</style>
