---
// BaseLayout.astro — 基础布局
// 用法：<BaseLayout title="页面标题"> ... </BaseLayout>

import { Image, getImage } from "astro:assets";
import bgImageRaw from "../assets/images/background.jpg";
import avatarRaw from "../assets/images/avatar.png";
import "../assets/css/global.css";
import "../assets/css/skeleton.css";
import NavBar from "../components/layout/NavBar.astro";
import Footer from "../components/layout/Footer.astro";
import SideWidgets from "../components/layout/SideWidgets.astro";
import TocModal from "../components/posts/TocModal.svelte";
import PostsFilterModal from "../components/posts/PostsFilterModal.svelte";
import CustomScrollbar from "../components/layout/CustomScrollbar.astro";
import { site } from "../data/site";

const avatarImage = await getImage({
  src: avatarRaw,
  format: "webp",
  quality: 80,
  width: 192,
});

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title,
  description = site.description,
  bodyClass = "",
} = Astro.props;

const pageTitle = title ? `${title} - ${site.name}` : site.name;
const bgAspectStyle = `@media (min-aspect-ratio: ${bgImageRaw.width}/${bgImageRaw.height}) { img.bg-layer { object-fit: fill; } }`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content={site.colorScheme} />
    <link rel="icon" type="image/webp" href={avatarImage.src} />
    <title>{pageTitle}</title>
    <style set:html={bgAspectStyle} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>

    <Image
      src={bgImageRaw}
      alt=""
      class="bg-layer"
      loading="eager"
      decoding="async"
      aria-hidden="true"
    />
    <div class="page">
      <NavBar />
      <main class="hero transition-main" id="swup">
        <slot />
      </main>
      <Footer />
    </div>
    <!-- 侧边悬浮按钮列：静态标记，运行时（可用性/显隐/进度）由 swup-widgets.js 控制 -->
    <SideWidgets />
    <TocModal client:idle />
    <PostsFilterModal client:idle />
    <CustomScrollbar />
    <script>
      // swup-widgets.js：侧边按钮运行时控制器（模块脚本只执行一次，无需 is:inline）
      import '../assets/js/swup-widgets.js';
    </script>
  </body>
</html>
