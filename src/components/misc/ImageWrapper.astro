---
// ImageWrapper.astro — 图片包装组件，支持本地图片自动压缩
// 参考 Fuwari 的实现方式，支持自定义路径
import path from "node:path";

interface Props {
  src: string;
  alt?: string;
  class?: string;
  basePath?: string;
  style?: string;
}

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const { src, alt = "", basePath = "/", style } = Astro.props;
const className = Astro.props.class;

// 判断是否为本地图片（非 URL、非 data URI）
const isLocal = !(
  src.startsWith("/") ||
  src.startsWith("http") ||
  src.startsWith("https") ||
  src.startsWith("data:")
);

let img: ImageMetadata | undefined;

if (isLocal) {
  // glob 导入 src/ 下所有图片文件
  const files = import.meta.glob<ImageMetadata>("../../**/*.{png,jpg,jpeg,gif,webp,svg}", {
    import: "default",
  });

  // 构造完整路径：从 src/ 目录开始
  const normalizedPath = path
    .normalize(path.join("../../", basePath, src))
    .replace(/\\/g, "/");

  const file = files[normalizedPath];
  if (file) {
    img = await file();
  } else {
    console.error(
      `\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
    );
  }
}

const imageClass = className || "w-full h-full object-cover";
---

{isLocal && img && <Image src={img} alt={alt} class={imageClass} style={style} />}
{!isLocal && <img src={src} alt={alt} class={imageClass} loading="lazy" decoding="async" style={style} />}
